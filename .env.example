# HTTP_DNS_ADDR defaults to PIHOLE_DNS_ADDR.
DOH_PROBE_URL=https://1.1.1.1/dns-query
# Name|URL runs every 30s; Name|cache-bust|URL runs every 5m.
ASSET_PROBES=YouTube thumbnail|https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg;Cloudflare cache-busted|cache-bust|https://speed.cloudflare.com/__down?bytes=32768
