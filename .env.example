APP_PASSWORD=replace-with-a-long-random-password
APP_LISTEN_ADDR=:8080
PIHOLE_DNS_ADDR=192.168.1.2:53
# LAN router. Empty = auto from the host default route (requires network_mode: host).
GATEWAY_ADDR=
# Leave empty to auto-discover the hop after the LAN gateway.
ISP_HOP_ADDR=
TCP_CONTROLS=cloudflare|1.1.1.1:443;google|8.8.8.8:443;quad9|9.9.9.9:443
# Optional Pi-hole v6 incident correlation. Set both values or leave both empty.
PIHOLE_API_URL=
PIHOLE_API_PASSWORD=
# Set true only when API is HTTP on a trusted private network.
PIHOLE_API_ALLOW_INSECURE_HTTP=false
APP_TIMEZONE=Europe/Budapest
APP_COOKIE_SECURE=false
APP_PORT=8080
HTTP_EXPECTED_STATUS=204
# HTTP_DNS_ADDR defaults to PIHOLE_DNS_ADDR.
DOH_PROBE_URL=https://1.1.1.1/dns-query
# Name|URL runs every 30s; Name|cache-bust|URL runs every 5m.
ASSET_PROBES=YouTube thumbnail|https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg;Cloudflare cache-busted|cache-bust|https://speed.cloudflare.com/__down?bytes=32768
