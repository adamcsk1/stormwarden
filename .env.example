APP_PASSWORD=replace-with-a-long-random-password
PIHOLE_DNS_ADDR=192.168.1.2:53
APP_TIMEZONE=Europe/Budapest
APP_COOKIE_SECURE=false
APP_PORT=8080
HTTP_EXPECTED_STATUS=204
# HTTP_DNS_ADDR defaults to PIHOLE_DNS_ADDR.
DOH_PROBE_URL=https://1.1.1.1/dns-query
# One Name|URL entry; use semicolons between multiple entries in .env.
ASSET_PROBES=YouTube thumbnail|https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg
